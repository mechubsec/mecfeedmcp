# mecfeed-serve read-only feed server container image
#
# Multi-stage build producing a distroless image with no shell. Builder glibc
# generation must be ≤ runtime generation: Debian 13 (trixie) on both sides.

# Pinned to the multi-arch image index digest resolved on 2026-08-25.
FROM rust:1.99-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7 AS builder

WORKDIR /build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/mecfeedmcp/Cargo.toml crates/mecfeedmcp/
COPY crates/mecfeedmcp-core/Cargo.toml crates/mecfeedmcp-core/
COPY crates/mecfeed-serve/Cargo.toml crates/mecfeed-serve/

RUN mkdir -p crates/mecfeedmcp/src crates/mecfeedmcp-core/src crates/mecfeed-serve/src && \
    echo 'fn main() {}' > crates/mecfeedmcp/src/main.rs && \
    echo '' > crates/mecfeedmcp/src/lib.rs && \
    echo 'fn main() {}' > crates/mecfeed-serve/src/main.rs && \
    echo '' > crates/mecfeedmcp-core/src/lib.rs && \
    cargo build --release -p mecfeed-serve && \
    rm -rf crates/mecfeedmcp/src crates/mecfeedmcp-core/src crates/mecfeed-serve/src

COPY crates/ crates/
RUN touch crates/mecfeedmcp/src/main.rs crates/mecfeedmcp-core/src/lib.rs crates/mecfeed-serve/src/main.rs && \
    cargo build --release --locked -p mecfeed-serve

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:cc66d222f0a7ec996b78a99fe76a969bc80b539a5016ad866c14d1949bc6d0ab

USER 65532:65532

COPY --from=builder /build/target/release/mecfeed-serve /usr/local/bin/mecfeed-serve

LABEL org.opencontainers.image.title="mecfeed-serve"
LABEL org.opencontainers.image.description="Read-only TLS feed server firewalls pull from"
LABEL org.opencontainers.image.source="https://github.com/mechubsec/mecfeedmcp"
LABEL org.opencontainers.image.licenses="MIT"

# TLS, snapshot, trust and client-list paths live in ENTRYPOINT so an operator --listen override cannot drop them.
ENTRYPOINT ["/usr/local/bin/mecfeed-serve", \
    "--tls-cert", "/etc/mecfeed-serve/tls.crt", \
    "--tls-key", "/etc/mecfeed-serve/tls.key", \
    "--snapshot-dir", "/var/lib/mecfeed-snapshots", \
    "--feed-config", "/etc/mecfeedmcp/feed.json", \
    "--trusted-snapshot-key", "/etc/mecfeed-serve/snapshot-signing.pub", \
    "--clients-file", "/etc/mecfeed-serve/clients.json"]
CMD ["--listen", "0.0.0.0:8443"]
