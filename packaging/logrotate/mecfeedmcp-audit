# logrotate fragment for the mecfeedmcp JSON audit sink.
#
# Install as /etc/logrotate.d/mecfeedmcp-audit (root:root, mode 0644).
# Enable the sink by passing --audit-log-file. The path below matches the
# packaged systemd unit, which runs as mecfeedmcp:mecfeedmcp with
# StateDirectory=mecfeedmcp (/var/lib/mecfeedmcp writable under
# ProtectSystem=strict). Adjust paths/retention to your policy.
#
# Rename + reopen, not copytruncate:
#   The server keeps the AuditFileSink handle mecmcp_audit::init_tracing
#   returns and reopens it by path on SIGHUP, alongside the existing
#   tokens.json hot reload. logrotate renames the file below, sends SIGHUP
#   through `postrotate`, and every write after that point goes to a fresh
#   inode at the same path. Nothing written before the rename is truncated
#   and nothing written after it is lost — unlike copytruncate, which drops
#   whatever lands between its copy and its truncate.

/var/lib/mecfeedmcp/audit.jsonl {
    daily
    rotate 14
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    su mecfeedmcp mecfeedmcp
    postrotate
        systemctl kill -s HUP mecfeedmcp.service >/dev/null 2>&1 || true
    endscript
}
